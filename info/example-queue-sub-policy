Example queue policy, as generated by SQS -> Set Policy.
Lets the SNS topic deliver messages to the queue, and nothing else.
(123456789012 is a placeholder account ID)

{
  "Version": "2012-10-17",
  "Id": "arn:aws:sqs:eu-west-2:123456789012:test-queue/SQSDefaultPolicy",
  "Statement": [
    {
      "Sid": "Sid1517849186492",
      "Effect": "Allow",
      "Principal": {
        "Service": "sns.amazonaws.com"
      },
      "Action": "SQS:SendMessage",
      "Resource": "arn:aws:sqs:eu-west-2:123456789012:test-queue",
      "Condition": {
        "ArnEquals": {
          "aws:SourceArn": "arn:aws:sns:eu-west-2:123456789012:test-topic"
        }
      }
    }
  ]
}
