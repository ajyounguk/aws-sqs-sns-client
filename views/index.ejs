<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <link rel="stylesheet" href="/assets/styles.css">
    <title>SNS SQS Client</title>
</head>

<body>

<header class="topbar">
    <h1>AWS SNS/SQS Client</h1>
    <span class="env env-<%= connection.kind %>" title="<%= connection.kind === 'aws' ? 'Requests go to real AWS' : 'Requests go to ' + connection.label %>">
        <span class="env-dot"></span>
        <%= connection.label %><% if (connection.region) { %> &middot; <%= connection.region %><% } %>
    </span>
</header>

<div class="layout">
    <%- include('partials/nav'); %>

    <main>
        <%- include('partials/sqs'); %>
        <%- include('partials/sns'); %>
    </main>
</div>

<script src="/assets/app.js"></script>
</body>
</html>
