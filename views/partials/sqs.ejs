<% const panel = n => 'panel' + (ui.menuitem === n ? ' active' : '') %>

<!-- 1. Create Queue -->
<section class="<%= panel(1) %>" data-item="1">
    <h2>Create Queue</h2>
    <form method="POST" action="/sqs-queue">
        <label for="p1-queuename">Queue name</label>
        <input id="p1-queuename" type="text" name="queuename" value="<%= ui.def_sqsname %>" placeholder="my-queue" required>
        <div class="actions"><button type="submit">Create queue</button></div>
    </form>
    <%- include('response', { r: ui.data[1] }) %>
</section>

<!-- 2. List all Queues -->
<section class="<%= panel(2) %>" data-item="2">
    <h2>List Queues</h2>
    <form method="GET" action="/sqs-queue/list">
        <div class="actions"><button type="submit">List queues</button></div>
    </form>
    <%- include('response', { r: ui.data[2] }) %>
</section>

<!-- 3. Get Queue Url -->
<section class="<%= panel(3) %>" data-item="3">
    <h2>Get Queue URL</h2>
    <form method="GET" action="/sqs-queue">
        <label for="p3-queuename">Queue name</label>
        <input id="p3-queuename" type="text" name="queuename" value="<%= ui.def_sqsname %>" placeholder="my-queue" required>
        <div class="actions"><button type="submit">Get queue URL</button></div>
    </form>
    <%- include('response', { r: ui.data[3] }) %>
</section>

<!-- 4. Get Queue Attributes -->
<section class="<%= panel(4) %>" data-item="4">
    <h2>Get Queue Attributes</h2>
    <form method="GET" action="/sqs-queue/attributes">
        <label for="p4-queueurl">Queue URL</label>
        <input id="p4-queueurl" type="text" name="queueurl" value="<%= ui.def_sqsurl %>" placeholder="https://sqs.region.amazonaws.com/account/queue" required>
        <div class="actions"><button type="submit">Get attributes</button></div>
    </form>
    <%- include('response', { r: ui.data[4] }) %>
</section>

<!-- 5. Post Message to Queue -->
<section class="<%= panel(5) %>" data-item="5">
    <h2>Send Message</h2>
    <form method="POST" action="/sqs-queue/message">
        <label for="p5-queueurl">Queue URL</label>
        <input id="p5-queueurl" type="text" name="queueurl" value="<%= ui.def_sqsurl %>" placeholder="https://sqs.region.amazonaws.com/account/queue" required>
        <label for="p5-message">Message</label>
        <textarea id="p5-message" name="message" rows="5" placeholder="Message body - text or JSON" required></textarea>
        <div class="actions"><button type="submit">Send message</button></div>
    </form>
    <%- include('response', { r: ui.data[5] }) %>
</section>

<!-- 6. Get Message from Queue -->
<section class="<%= panel(6) %>" data-item="6">
    <h2>Receive Message</h2>
    <form method="GET" action="/sqs-queue/message">
        <label for="p6-queueurl">Queue URL</label>
        <input id="p6-queueurl" type="text" name="queueurl" value="<%= ui.def_sqsurl %>" placeholder="https://sqs.region.amazonaws.com/account/queue" required>
        <p class="hint">The message stays hidden from other consumers for 60 seconds.</p>
        <div class="actions"><button type="submit">Receive message</button></div>
    </form>
    <%- include('response', { r: ui.data[6] }) %>
</section>

<!-- 7. Delete Message from Queue -->
<section class="<%= panel(7) %>" data-item="7">
    <h2>Delete Message</h2>
    <form method="POST" action="/sqs-queue/message/delete">
        <label for="p7-queueurl">Queue URL</label>
        <input id="p7-queueurl" type="text" name="queueurl" value="<%= ui.def_sqsurl %>" placeholder="https://sqs.region.amazonaws.com/account/queue" required>
        <label for="p7-messagehandle">Receipt handle</label>
        <input id="p7-messagehandle" type="text" name="messagehandle" value="<%= ui.def_msghandle %>" placeholder="From Receive Message" required>
        <div class="actions"><button type="submit">Delete message</button></div>
    </form>
    <%- include('response', { r: ui.data[7] }) %>
</section>

<!-- 8. Purge Queue (delete all messsages) -->
<section class="<%= panel(8) %>" data-item="8">
    <h2>Purge Queue</h2>
    <form method="POST" action="/sqs-queue/purge" data-confirm="Purge ALL messages from this queue?">
        <label for="p8-queueurl">Queue URL</label>
        <input id="p8-queueurl" type="text" name="queueurl" value="<%= ui.def_sqsurl %>" placeholder="https://sqs.region.amazonaws.com/account/queue" required>
        <p class="hint">Deletes every message in the queue. This can't be undone.</p>
        <div class="actions"><button type="submit" class="danger">Purge queue</button></div>
    </form>
    <%- include('response', { r: ui.data[8] }) %>
</section>

<!-- 9. Delete Queue (deletes queue and all messsages) -->
<section class="<%= panel(9) %>" data-item="9">
    <h2>Delete Queue</h2>
    <form method="POST" action="/sqs-queue/delete" data-confirm="Delete this queue and all its messages?">
        <label for="p9-queueurl">Queue URL</label>
        <input id="p9-queueurl" type="text" name="queueurl" value="<%= ui.def_sqsurl %>" placeholder="https://sqs.region.amazonaws.com/account/queue" required>
        <p class="hint">Deletes the queue and all its messages. This can't be undone.</p>
        <div class="actions"><button type="submit" class="danger">Delete queue</button></div>
    </form>
    <%- include('response', { r: ui.data[9] }) %>
</section>

<!-- 10. Set queue attributes -->
<section class="<%= panel(10) %>" data-item="10">
    <h2>Set Queue Policy</h2>
    <form method="POST" action="/sqs/setqattr">
        <label for="p10-sqsurl">Queue URL</label>
        <input id="p10-sqsurl" type="text" name="sqsurl" value="<%= ui.def_sqsurl %>" placeholder="https://sqs.region.amazonaws.com/account/queue" required>
        <label for="p10-sqsarn">Queue ARN</label>
        <input id="p10-sqsarn" type="text" name="sqsarn" value="<%= ui.def_sqsarn %>" placeholder="From Get Attributes" required>
        <label for="p10-snsarn">Topic ARN</label>
        <input id="p10-snsarn" type="text" name="snsarn" value="<%= ui.def_snsarn %>" placeholder="arn:aws:sns:region:account:topic" required>
        <p class="hint">Replaces the queue's policy with one that lets only this SNS topic send messages to it.</p>
        <div class="actions"><button type="submit">Set policy</button></div>
    </form>
    <%- include('response', { r: ui.data[10] }) %>
</section>
